<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ platform splash screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#F8F7FF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/launch_image</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F8F7FF</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
